<%- include('partials/header', { title: title }) %>

<main class="categories-page">
    <h1><%= title %></h1>

    <p class="intro">
        Explore the different categories of service opportunities available in our network.
        Find a cause that matches your interests and make a positive impact in your community.
    </p>

    <section class="categories-grid">

        <% if (categories.length > 0) { %>

            <% categories.forEach(category => { %>

                <article class="category-card">
                    <h2><%= category.name %></h2>
                </article>

            <% }); %>

        <% } else { %>

            <p>No service categories are currently available.</p>

        <% } %>

    </section>
</main>

<%- include('partials/footer') %>