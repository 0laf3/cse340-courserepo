<%- include("partials/header") %>

<main class="container">

    <h1>Add New Organization</h1>

    <form
        action="/new-organization"
        method="POST"
    >

        <!-- ==================================
             Organization Name
             ================================== -->

        <div class="form-group">

            <label for="name">
                Organization Name
            </label>

            <input
                type="text"
                id="name"
                name="name"
                required
                maxlength="150"
                placeholder="Enter organization name"
            >

        </div>


        <!-- ==================================
             Organization Description
             ================================== -->

        <div class="form-group">

            <label for="description">
                Description
            </label>

            <textarea
                id="description"
                name="description"
                required
                maxlength="500"
                placeholder="Enter organization description"
                rows="6"
            ></textarea>

        </div>


        <!-- ==================================
             Contact Email
             ================================== -->

        <div class="form-group">

            <label for="contactEmail">
                Contact Email
            </label>

            <input
                type="email"
                id="contactEmail"
                name="contactEmail"
                required
                placeholder="example@email.com"
            >

        </div>


        <!-- ==================================
             Submit
             ================================== -->

        <button
            type="submit"
        >
            Add Organization
        </button>

    </form>

</main>

</body>
</html>