<%- include("partials/header") %>

<main>
    <h1><%= title %></h1>

    <% if (user && user.role_name === "admin") { %>
        <p>
            <a href="/new-organization">
                Add New Organization
            </a>
        </p>
    <% } %>

    <% if (organizations && organizations.length > 0) { %>
        <section>
            <% organizations.forEach(organization => { %>
                <article>
                    <h2>
                        <img
                            src="/images/<%= organization.logo_filename || 'placeholder-logo.png' %>"
                            alt="<%= organization.name %> logo"
                        >

                        <a href="/organization/<%= organization.organization_id %>">
                            <%= organization.name %>
                        </a>
                    </h2>

                    <% if (organization.description) { %>
                        <p>
                            <strong>Description:</strong>
                            <%= organization.description %>
                        </p>
                    <% } %>

                    <% if (organization.contact_email) { %>
                        <p>
                            <strong>Contact Email:</strong>
                            <%= organization.contact_email %>
                        </p>
                    <% } %>

                    <% if (user && user.role_name === "admin") { %>
                        <p>
                            <a href="/edit-organization/<%= organization.organization_id %>">
                                Edit Organization
                            </a>
                        </p>
                    <% } %>
                </article>

                <hr>
            <% }) %>
        </section>
    <% } else { %>
        <p>No organizations have been added yet.</p>
    <% } %>
</main>

<%- include("partials/footer") %>