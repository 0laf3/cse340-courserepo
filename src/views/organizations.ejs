<%- include("partials/header") %>

<main>
    <h1><%= title %></h1>

    <p>
        Browse our partner organizations and their service projects.
    </p>

    <% if (organizations.length > 0) { %>

        <ul>
            <% organizations.forEach(organization => { %>

                <li>
                    <h2>
                        <img
                             src="/images/<%= organization.logo_filename %>"
                             alt="<%= organization.name %> logo"
                >
                        <a href="/organization/<%= organization.organization_id %>">
                            <%= organization.name %>
                        </a>
                    </h2>

                    <% if (organization.description) { %>
                        <p>
                            <%= organization.description %>
                        </p>
                    <% } %>

                </li>

            <% }) %>
        </ul>

    <% } else { %>

        <p>
            There are currently no organizations available.
        </p>

    <% } %>

    <p>
        <a href="/new-organization">
            Add a new organization
        </a>
    </p>
</main>

<%- include("partials/footer") %>