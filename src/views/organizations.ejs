<%- include("partials/header") %>

<main>

    <h1>
        <%= title %>
    </h1>


    <p>
        <a href="/new-organization">
            Add New Organization
        </a>
    </p>


    <% if (
        organizations &&
        organizations.length > 0
    ) { %>

        <section>

            <% organizations.forEach(
                organization => {
            %>

                <article>

                    <h2>
                        <a
                            href="/organization/<%= organization.organization_id %>"
                        >
                            <%= organization.name %>
                        </a>
                    </h2>


                    <% if (
                        organization.description
                    ) { %>

                        <p>
                            <strong>
                                Description:
                            </strong>

                            <%= organization.description %>
                        </p>

                    <% } %>


                    <% if (
                        organization.contact_email
                    ) { %>

                        <p>
                            <strong>
                                Contact Email:
                            </strong>

                            <%= organization.contact_email %>
                        </p>

                    <% } %>


                    <p>

                        <a
                            href="/edit-organization/<%= organization.organization_id %>"
                        >
                            Edit Organization
                        </a>

                    </p>


                    <!-- Delete Organization -->

                    <form
                        action="/delete-organization/<%= organization.organization_id %>"
                        method="POST"
                        onsubmit="return confirm('Are you sure you want to delete this organization?');"
                    >

                        <button type="submit">
                            Delete Organization
                        </button>

                    </form>

                </article>

                <hr>

            <% }) %>

        </section>

    <% } else { %>

        <p>
            No organizations have been added yet.
        </p>

    <% } %>

</main>

<%- include("partials/footer") %>