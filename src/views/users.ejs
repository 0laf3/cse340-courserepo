<%- include("partials/header") %>

<main>
    <h1><%= title %></h1>

    <p>
        This page displays all registered users and their assigned roles.
    </p>

    <% if (users && users.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email (Username)</th>
                    <th>Role</th>
                </tr>
            </thead>

            <tbody>
                <% users.forEach(registeredUser => { %>
                    <tr>
                        <td><%= registeredUser.name %></td>
                        <td><%= registeredUser.email %></td>
                        <td><%= registeredUser.role_name %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <p>No registered users were found.</p>
    <% } %>

    <p>
        <a href="/dashboard">Return to Dashboard</a>
    </p>
</main>

<%- include("partials/footer") %>