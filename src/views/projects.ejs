<%- include("partials/header") %>

<main>
    <h1><%= title %></h1>

    <p>
        Here are the next five upcoming service projects.
    </p>

    <% if (projects.length > 0) { %>

        <ul>
            <% projects.forEach(project => { %>

                <li>
                    <h2>
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </h2>

                    <p>
                        Organization:
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <p>
                        Date: <%= project.date %>
                    </p>

                    <p>
                        Location: <%= project.location %>
                    </p>
                </li>

            <% }) %>
        </ul>

    <% } else { %>

        <p>
            There are currently no upcoming service projects.
        </p>

    <% } %>
</main>

<%- include("partials/footer") %>